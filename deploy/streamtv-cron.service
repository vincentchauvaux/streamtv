[Unit]
Description=StreamTV cron — rescan playlists + EPG
After=streamtv.service
Requires=streamtv.service

[Service]
Type=oneshot
EnvironmentFile=-/root/streamtv/.env
ExecStart=/bin/bash -c 'test -n "$CRON_SECRET" && curl -sf -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3001/api/cron/scan'
